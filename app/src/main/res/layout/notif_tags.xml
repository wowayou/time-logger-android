<?xml version="1.0" encoding="utf-8"?>
<!-- 通知展开态里的标签网格。系统只给 3 个 action 位，标签放在 action 里必然放不下；
     自定义视图里的按钮数量不受这个限制（DecoratedCustomViewStyle 会把它套进系统模板）。
     6 个槽，用不满的隐藏。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/n_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/n_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView android:id="@+id/n_tag0" style="@style/NotifChip" />
        <TextView android:id="@+id/n_tag1" style="@style/NotifChip" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/n_tag2" style="@style/NotifChip" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView android:id="@+id/n_tag3" style="@style/NotifChip" />
        <TextView android:id="@+id/n_tag4" style="@style/NotifChip" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/n_tag5" style="@style/NotifChip" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
