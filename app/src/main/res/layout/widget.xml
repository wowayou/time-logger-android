<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 两个视图轮换显示：有起点时用 Chronometer（自己走秒，不需要任何唤醒，
             RemoteViews 只在写入/回前台/30 分钟周期时重画，靠 TextView 会冻住），
             没有镜像或被守卫拦下时退回普通文字。 -->
        <Chronometer
            android:id="@+id/w_chrono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/status_no_mirror" />

        <TextView
            android:id="@+id/w_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="@color/accent_soft"
            android:textSize="13sp"
            android:text="@string/notif_open" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:textColor="#8b90a0"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView android:id="@+id/w_tag0" style="@style/WidgetChip" />
        <TextView android:id="@+id/w_tag1" style="@style/WidgetChip" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView android:id="@+id/w_tag2" style="@style/WidgetChip" />
        <TextView android:id="@+id/w_tag3" style="@style/WidgetChip" android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- 第三排只在小组件被拉高时出现（见 TimeLoggerWidget.rowsFor）。 -->
    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView android:id="@+id/w_tag4" style="@style/WidgetChip" />
        <TextView android:id="@+id/w_tag5" style="@style/WidgetChip" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
