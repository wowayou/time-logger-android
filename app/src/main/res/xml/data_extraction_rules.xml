<?xml version="1.0" encoding="utf-8"?>
<!-- 记录数据不进云备份也不进换机迁移：备份的唯一正当出口是应用内的「完整备份」
     （用户显式导出的 JSON）。让系统悄悄把 filesDir 搬到别处，会造出一份用户
     不知道存在、也无法验证的副本。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
